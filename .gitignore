# ==============================================================================
# Akansha AI Operating System / Autonomous Voice Agent - Root .gitignore
# ==============================================================================

# Node dependencies & package managers
node_modules/
.pnp/
.pnp.*

# Build, Bundler & Framework output
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# Environment and Local Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.secret
secrets/
private/
.akansha/

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.hypothesis/

# Logs and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev-server.log
frontend-dev.log

# Test and coverage output
coverage/
test-results/
playwright-report/
.playwright/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Agent & LLM tool caches
.agent/
.claude/
.kiro/
.codex/
.openrouter-cache/
.openai-cache/
.mcp-cache/
.codex-cache/
*.local.json
*.local.yaml
*.local.yml

# Databases and runtime stores
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
graphify-out/cache/

# Backend local runtime storage & database files
aura/backend/hermes/database/*.db
aura/backend/hermes/database/*.db-*
aura/backend/hermes/database/*.sqlite
aura/backend/hermes/database/*.sqlite*
aura/backend/hermes/database/*.sqlite3
aura/backend/hermes/database/*.sqlite3*
aura/backend/uploads/
aura/backend/generated/
aura/backend/tmp/
aura/backend/.cache/
aura/backend/local_storage/
aura/backend/memory/
aura/backend/vector_store/
aura/backend/chroma/
aura/backend/faiss/
graphify/users/
*.akansha-graph.json

# Model weights (large binaries)
aura/backend/voice_models/
backend/voice_models/
*.onnx

# Nested / reference repositories
openwork/

# Generated artifacts & runtime downloads
generated/
downloads/
exports/
artifacts/
generated_artifacts/
aura/generated_artifacts/
aura/public/generated/
aura/generated/
aura/downloads/
aura/exports/
aura/artifacts/
*.generated.pdf
*.generated.docx
*.generated.pptx
*.generated.xlsx
*.generated.csv
*.generated.json
*.generated.zip

# Voice and screenshot scratch files
recordings/
screenshots/
aura/recordings/
aura/screenshots/
aura/tmp_voice_recording_frames/
*.mp3.tmp
*.mp4.tmp
*.png.tmp
*.jpg.tmp

# Scratch HTML & debug files
tmp_*/
*.tmp
*.temp
*.bak
aura/codechef-login.html
aura/tmp-chat.html
aura/debug_prompt.txt

# ==============================================================================
# Whitelisted Assets, Images & Documentation
# ==============================================================================
!aura/public/assets/**
!aura/public/assets/images/**
!aura/public/assets/presence/**
!aura/public/favicon.ico
!public/assets/**
!public/assets/images/**
!public/assets/presence/**
!graphify-out/akansha-*.png
!graphify-out/*.svg
!graphify-out/*.jpg
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/graph.json
