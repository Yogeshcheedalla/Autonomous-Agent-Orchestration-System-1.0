OPENROUTER_API_KEY=your_openrouter_key
# Leave this commented out to use the code's own default, which is a concrete
# free model. It was previously set to openai/gpt-4o-mini here -- a paid route,
# so a fresh clone with a zero-balance key spent one wasted request returning
# HTTP 402 before the cooldown demoted it. Uncomment and name a model only if you
# have credit and want that specific one; "openrouter/auto" is not a valid value.
# Free routes also get retired without warning -- the value that used to be shown
# here now answers 404 "This model is unavailable for free" -- which is the other
# reason to leave it commented and let the code default carry it.
# OPENROUTER_MODEL=

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# Meta one-click auth for WhatsApp Business / Instagram Messaging.
# WhatsApp and Instagram use Meta auth, but each still needs approved Meta permissions.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
AKANSHA_META_OAUTH_REDIRECT_URI=http://localhost:8000/api/social/oauth/callback/meta

# X / Twitter one-click auth. This is separate from Meta and cannot share a Meta token.
X_CLIENT_ID=your_x_oauth_client_id
X_CLIENT_SECRET=your_x_oauth_client_secret
AKANSHA_X_OAUTH_REDIRECT_URI=http://localhost:8000/api/social/oauth/callback/x

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_irina_cloned_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
